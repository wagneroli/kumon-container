        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ participante_id: id }),
      },
      3
    );

    if (r.ok) {
      alert(`${nome} marcado como AUSENTE!`);
      setTimeout(atualizarDashboard, 500);
      setTimeout(carregarListaPresenca, 2000);
    } else {
      const err = await r.json();
      alert("Erro: " + (err.error || "Falha ao marcar ausente"));
    }

    if (btn) {
      btn.disabled = false;
      btn.style.opacity = "1";
    }
  } catch (e) {
    alert("Erro na comunicação com o servidor");
    const btn = document.getElementById(`btn-${id}`);
    if (btn) {
      btn.disabled = false;
      btn.style.opacity = "1";
    }
  }
}

// ===== PREMIAÇÕES =====

async function inicializarPremiacoes() {
  console.log("Inicializando premiações");

  try {
    const r = await fetch(API_URL + "/categorias");
    const categorias = await r.json();

    const selectCat = document.getElementById("select-categoria");
    selectCat.innerHTML = '<option value="">Selecione uma categoria</option>';

    categorias.forEach((cat) => {
      const option = document.createElement("option");
      option.value = cat.id;
      option.textContent = cat.nome;
      selectCat.appendChild(option);
    });

    selectCat.addEventListener("change", function () {
      if (this.value) {
        carregarPremiosPorCategoria(parseInt(this.value));
      }
    });
  } catch (e) {
    console.error("Erro ao carregar categorias:", e);
    const selectCat = document.getElementById("select-categoria");
    selectCat.innerHTML =
      '<option value="">Erro ao carregar categorias</option>';
  }
}

function carregarPremiosPorCategoria(categoria_id) {
  if (!categoria_id) {
    document.getElementById("lista-premios-container").innerHTML =
      "Selecione uma categoria para ver os alunos";
    return;
  }

  fetch(`${API_URL}/premios/categoria/${categoria_id}`)
    .then((r) => r.json())
    .then((data) => {
      if (!data || data.length === 0) {
        document.getElementById("lista-premios-container").innerHTML =
          "Nenhum aluno nesta categoria";
        return;
      }
      renderizarListaPremios(data);
    })
    .catch((e) => console.error("Erro ao carregar prêmios:", e));
}

function renderizarListaPremios(lista) {
  let html = `
    <table class="premiacoes-table">
      <thead>
        <tr>
          <th>Categoria</th>
          <th>Nome</th>
          <th>Status Presente</th>
          <th>Status Entrega</th>
          <th>Ação</th>
        </tr>
      </thead>
      <tbody>
  `;

  lista.forEach((premio) => {
    html += `
      <tr id="premio-${premio.id}">
        <td><strong>${premio.categoria_nome}</strong></td>
        <td>${premio.nome}</td>
        <td>
          <select class="form-control" style="width:120px;" onchange="atualizarPremio(${
            premio.id
          }, 'presente', this.value);">
            <option value="SIM" ${
              premio.status_presente === "SIM" ? "selected" : ""
            }>SIM</option>
            <option value="NAO" ${
              premio.status_presente === "NAO" ? "selected" : ""
            }>NÃO</option>
          </select>
        </td>
        <td>
          <select class="form-control" style="width:120px;" onchange="atualizarPremio(${
            premio.id
          }, 'entrega', this.value);">
            <option value="SIM" ${
              premio.status_entrega === "SIM" ? "selected" : ""
            }>SIM</option>
            <option value="NAO" ${
              premio.status_entrega === "NAO" ? "selected" : ""
            }>NÃO</option>
          </select>
        </td>
        <td><small style="color:#999;">ID: ${premio.id}</small></td>
      </tr>
    `;
  });

  html += `
      </tbody>
    </table>
  `;

  document.getElementById("lista-premios-container").innerHTML = html;
}

function atualizarPremio(premioId, tipo, novoValor) {
  const row = document.querySelector(`#premio-${premioId}`);
  const statusPresente =
    tipo === "presente"
      ? novoValor
      : row.querySelector("td:nth-child(3) select").value;
  const statusEntrega =
    tipo === "entrega"
      ? novoValor
      : row.querySelector("td:nth-child(4) select").value;

  fetch(`${API_URL}/premios/${premioId}`, {
    method: "PUT",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      status_presente: statusPresente,
      status_entrega: statusEntrega,
    }),
  })
    .then((r) => r.json())
    .then((data) => {
      if (data.sucesso) {
        console.log(`✓ Prêmio ${premioId} atualizado`);
      } else {
        console.error("Erro ao atualizar:", data.erro);
      }
    })
    .catch((e) => console.error("Erro na requisição:", e));
}

function showTab(tabId) {
  document.querySelectorAll(".tab-content").forEach((tab) => {
    tab.style.display = "none";
  });
  document.querySelectorAll(".tab-btn").forEach((btn) => {
    btn.classList.remove("active");
    btn.style.borderBottom = "3px solid transparent";
    btn.style.color = "#999";
  });
  document.getElementById(tabId).style.display = "block";
  event.target.classList.add("active");
  event.target.style.borderBottom = "3px solid #32b8c6";
  event.target.style.color = "#2b5a5f";
}

async function atualizarStatusPago(participanteId) {
  const select = document.getElementById(`select-pago-${participanteId}`);
  const statusPago = select.value;

  if (!statusPago) return;

  try {
    const response = await fetchWithRetry(
      API_URL + "/presenca/update-pago",
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          participante_id: participanteId,
          status_pago: statusPago,
        }),
      },
      3
    );

    const data = await response.json();
    if (response.ok) {
      console.log("✓ Status pago atualizado:", statusPago);
      carregarListaPresenca();
    } else {
      alert("Erro: " + (data.error || "Erro desconhecido"));
      carregarListaPresenca();
    }
  } catch (error) {
    console.error("Erro ao atualizar status pago:", error);
    alert("Erro ao atualizar status de pagamento");
  }
}
