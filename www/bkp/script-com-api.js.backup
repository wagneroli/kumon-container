console.log("✓ Script carregado v1000 (COM CONCORRÊNCIA SEGURA!)");

const API_URL = "/api";
let listaParticipantesCompleta = [];

// 🔄 NOVO: Função auxiliar com retry automático para concorrência segura
async function fetchWithRetry(url, options = {}, maxRetries = 3) {
  for (let i = 0; i < maxRetries; i++) {
    try {
      const response = await fetch(url, options);
      if (response.ok || response.status !== 500) {
        return response;
      }

      // Deadlock ou timeout (erro 500) - aguarda e tenta novamente
      console.warn(`Tentativa ${i + 1}/${maxRetries} falhou, aguardando...`);
      const waitTime = 1000 * (i + 1); // Backoff exponencial: 1s, 2s, 3s
      await new Promise((r) => setTimeout(r, waitTime));
    } catch (error) {
      if (i === maxRetries - 1) throw error;
      const waitTime = 1000 * (i + 1);
      await new Promise((r) => setTimeout(r, waitTime));
    }
  }
  return response;
}

document.addEventListener("DOMContentLoaded", function () {
  console.log("✓ DOM pronto");
  inicializarNavegacao();
  atualizarDashboard();
  setInterval(atualizarDashboard, 120000);
});

function inicializarNavegacao() {
  const navBtns = document.querySelectorAll(".nav-btn");
  navBtns.forEach((btn) => {
    btn.addEventListener("click", function () {
      const pageId = this.dataset.page;
      navBtns.forEach((b) => b.classList.remove("active"));
      this.classList.add("active");
      document
        .querySelectorAll(".page")
        .forEach((p) => p.classList.remove("active"));
      const page = document.getElementById(pageId);
      if (page) page.classList.add("active");
      if (pageId === "gerenciar") carregarParticipantes();
      if (pageId === "recepcao") carregarListaPresenca();
      if (pageId === "premiacao") inicializarPremiacoes();
    });
  });
}

async function atualizarDashboard() {
  try {
    const r = await fetch(API_URL + "/stats");
    const s = await r.json();
    document.getElementById("stat-presentes").textContent =
      s.total_presentes || 0;
    document.getElementById("stat-registrados").textContent =
      s.total_participantes || 0;
    document.getElementById("stat-premios").textContent = s.total_premios || 0;
    document.getElementById("stat-sorteios").textContent =
      s.total_sorteios || 0;

    const total = s.total_participantes || 1;
    const presentes = s.total_presentes || 0;
    const pct = Math.round((presentes / total) * 100);
    document.getElementById("progress-presenca").style.width = pct + "%";
    document.getElementById("progress-text").textContent =
      presentes + " / " + total + " presentes (" + pct + "%)";
  } catch (e) {
    console.error("Erro ao atualizar dashboard:", e);
  }
}

async function carregarParticipantes() {
  try {
    const r = await fetch(API_URL + "/participantes");
    const lista = await r.json();
    const cont = document.getElementById("lista-participantes");

    if (!lista || lista.length === 0) {
      cont.innerHTML =
        "<p class='empty-state'>Nenhum participante registrado</p>";
      return;
    }

    let html = "";
    lista.forEach((p) => {
      html += `
        <div style="padding:12px;border:1px solid #ddd;margin:8px 0;border-radius:6px;">
          <strong>Nº ${p.numero} - ${p.nome}</strong><br/>
          Tipo: ${p.tipo} Status: ${p.status || "AUSENTE"} <br/>
          <button onclick="editarParticipante(${
            p.id
          })" style="padding:6px;background:#2158CE;color:white;border:none;cursor:pointer;margin-right:5px;border-radius:4px;">Editar</button>
          <button onclick="deletarParticipante(${p.id}, '${p.nome.replace(
        /"/g,
        '\\"'
      )}'" style="padding:6px;background:#C01527;color:white;border:none;cursor:pointer;border-radius:4px;">Deletar</button>
        </div>
      `;
    });
    cont.innerHTML = html;
  } catch (e) {
    console.error("Erro ao carregar participantes:", e);
  }
}

async function carregarListaPresenca() {
  try {
    console.log("Carregando lista de presença...");
    const r = await fetch(API_URL + "/presenca/lista");
    const lista = await r.json();
    listaParticipantesCompleta = lista;

    const buscaEl = document.getElementById("busca-recepcao");
    if (buscaEl) buscaEl.value = "";

    if (!lista || lista.length === 0) {
      document.getElementById("lista-presenca").innerHTML =
        "<p class='empty-state'>Nenhum participante registrado</p>";
      return;
    }

    console.log("✓ Carregados " + lista.length + " participantes");
    renderizarListaPresenca(lista);
  } catch (e) {
    console.error("Erro ao carregar lista de presença:", e);
  }
}

function filtrarListaPresenca() {
  const termo = document.getElementById("busca-recepcao").value.trim();
  if (!termo) {
    renderizarListaPresenca(listaParticipantesCompleta);
    return;
  }

  const filtrados = listaParticipantesCompleta.filter((p) => {
    const numero = parseInt(p.numero);
    const nome = p.nome.toLowerCase();
    const termoBusca = termo.toLowerCase();
    const termoNumerico = parseInt(termo);

    return (
      (!isNaN(termoNumerico) && numero === termoNumerico) ||
      nome.includes(termoBusca)
    );
  });

  if (filtrados.length === 0) {
    document.getElementById("lista-presenca").innerHTML =
      "<p style='text-align:center;color:#999;'>Nenhum encontrado</p>";
    return;
  }

  renderizarListaPresenca(filtrados);
}

function renderizarListaPresenca(lista) {
  const cont = document.getElementById("lista-presenca");
  let html = "";

  lista.forEach((p) => {
    const statusBD = p.status_presenca || "AUSENTE";
    const pagoBD = p.status_pago || "NAO_PAGO";
    const bg = statusBD === "PRESENTE" ? "#f0f9f9" : "#fff9f9";
    const color = statusBD === "PRESENTE" ? "#32B8C6" : "#A84B2F";
    const btnBg = statusBD === "PRESENTE" ? "#C01527" : "#32B8C6";
    const btnText =
      statusBD === "PRESENTE" ? "✗ Marcar Ausente" : "✓ Marcar Presente";
    const btnAction =
      statusBD === "PRESENTE" ? "marcarAusente" : "marcarPresenca";
    const pagoLabel = pagoBD === "PAGO" ? "✓ Pago" : "✗ Não pago";
    const pagoClass = pagoBD === "PAGO" ? "badge-pago" : "badge-nao-pago";
    const statusText = statusBD === "PRESENTE" ? "✓ PRESENTE" : "✗ AUSENTE";

    html += `
      <div id="participante-${
        p.id
      }" style="padding:12px;border:1px solid #ddd;margin:8px 0;border-radius:6px;background: ${bg};">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:15px;">
          <div style="flex:1;">
            <strong>Nº ${p.numero} - ${p.nome}</strong><br/>
            <span style="color:#666;font-size:13px;">ID: ${p.id} | Tipo: ${
      p.tipo
    }</span>
          </div>
          <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;">
            <span style="background: ${color}; color: white; padding: 6px 12px; border-radius: 12px; font-weight: bold; font-size: 12px;">${statusText}</span>
            <span class="badge-status ${pagoClass}">${pagoLabel}</span>
          </div>
        </div>
        <div style="display:flex;gap:8px;margin-top:8px;">
          <button id="btn-${p.id}" onclick="${btnAction}(${
      p.id
    }, '${p.nome.replace(
      /"/g,
      '\\"'
    )}')" style="flex:1;padding:10px;background: ${btnBg};color:white;border:none;cursor:pointer;border-radius:4px;font-weight:bold;">${btnText}</button>
          <select id="select-pago-${
            p.id
          }" class="form-control" style="width:200px;" onchange="atualizarStatusPago(${
      p.id
    });">
            <option value="">Pago?</option>
            <option value="PAGO" ${
              pagoBD === "PAGO" ? "selected" : ""
            }>Pago</option>
            <option value="NAO_PAGO" ${
              pagoBD === "NAO_PAGO" ? "selected" : ""
            }>Não</option>
          </select>
        </div>
      </div>
    `;
  });

  cont.innerHTML = html;
}

async function salvarParticipante() {
  const numero = document.getElementById("numero-input").value;
  const nome = document.getElementById("nome-input").value;
  const tipo = document.getElementById("tipo-input").value;
  const id = document.getElementById("participante-id").value;

  if (!numero || !nome) {
    alert("Preencha todos os campos obrigatórios");
    return;
  }

  const url = id
    ? `${API_URL}/participantes/${id}`
    : `${API_URL}/participantes`;
  const metodo = id ? "PUT" : "POST";

  fetch(url, {
    method: metodo,
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      numero: parseInt(numero),
      nome: nome,
      tipo: tipo,
    }),
  })
    .then((r) =>
      r.ok
        ? r.json()
        : r.json().then((e) => {
            throw new Error(e.error);
          })
    )
    .then(() => {
      alert(id ? "Atualizado!" : "Criado com sucesso!");
      limparFormulario();
      carregarParticipantes();
      atualizarDashboard();
    })
    .catch((e) => alert("Erro: " + e.message));
}

function editarParticipante(id) {
  fetch(`${API_URL}/participantes/${id}`)
    .then((r) => r.json())
    .then((p) => {
      document.getElementById("participante-id").value = id;
      document.getElementById("numero-input").value = p.numero;
      document.getElementById("nome-input").value = p.nome;
      document.getElementById("tipo-input").value = p.tipo;
    })
    .catch((e) => console.error("Erro ao editar:", e));
}

function deletarParticipante(id, nome) {
  if (!confirm(`Tem certeza que deseja deletar ${nome}?`)) return;

  fetch(`${API_URL}/participantes/${id}`, { method: "DELETE" })
    .then((r) => {
      if (r.ok) {
        alert("Participante deletado!");
        carregarParticipantes();
        atualizarDashboard();
      } else {
        throw new Error("Erro ao deletar");
      }
    })
    .catch((e) => alert("Erro: " + e.message));
}

function limparFormulario() {
  document.getElementById("participante-id").value = "";
  document.getElementById("numero-input").value = "";
  document.getElementById("nome-input").value = "";
  document.getElementById("tipo-input").value = "Aluno";
}

async function marcarPresenca(id, nome) {
  try {
    console.log(`Marcando presente para ID ${id} - ${nome}`);
    const btn = document.getElementById(`btn-${id}`);
    if (btn) {
      btn.disabled = true;
      btn.style.opacity = "0.6";
    }

    const r = await fetchWithRetry(
      API_URL + "/presenca",
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ participante_id: id }),
      },
      3
    );

    if (r.ok) {
      alert(`${nome} marcado como PRESENTE!`);
      setTimeout(atualizarDashboard, 500);
      setTimeout(carregarListaPresenca, 2000);
    } else {
      const err = await r.json();
      alert("Erro: " + (err.error || "Falha ao marcar presença"));
    }

    if (btn) {
      btn.disabled = false;
      btn.style.opacity = "1";
    }
  } catch (e) {
    alert("Erro na comunicação com o servidor");
    const btn = document.getElementById(`btn-${id}`);
    if (btn) {
      btn.disabled = false;
      btn.style.opacity = "1";
    }
  }
}

async function marcarAusente(id, nome) {
  try {
    console.log(`Marcando ausente para ID ${id} - ${nome}`);
    const btn = document.getElementById(`btn-${id}`);
    if (btn) {
      btn.disabled = true;
      btn.style.opacity = "0.6";
    }

    const r = await fetchWithRetry(
      API_URL + "/presenca/ausente",
