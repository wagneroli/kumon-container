console.log("✓ Script carregado v13 (Premiação corrigida.)!");

const API_URL = "/api";
let listaParticipantesCompleta = [];

document.addEventListener("DOMContentLoaded", function () {
  console.log("✓ DOM pronto");
  inicializarNavegacao();
  atualizarDashboard();
  setInterval(atualizarDashboard, 120000);
});

function inicializarNavegacao() {
  const navBtns = document.querySelectorAll(".nav-btn");
  navBtns.forEach((btn) => {
    btn.addEventListener("click", function () {
      const pageId = this.dataset.page;
      navBtns.forEach((b) => b.classList.remove("active"));
      this.classList.add("active");

      document
        .querySelectorAll(".page")
        .forEach((p) => p.classList.remove("active"));

      const page = document.getElementById(pageId);
      if (page) page.classList.add("active");

      // Inicializar componentes específicos de cada página
      if (pageId === "gerenciar") carregarParticipantes();
      if (pageId === "recepcao") carregarListaPresenca();
      if (pageId === "premiacao") inicializarPremiacoes();
    });
  });
}

async function atualizarDashboard() {
  try {
    const r = await fetch(API_URL + "/stats");
    const s = await r.json();
    document.getElementById("stat-presentes").textContent =
      s.total_presentes || 0;
    document.getElementById("stat-registrados").textContent =
      s.total_participantes || 0;
    document.getElementById("stat-premios").textContent = s.total_premios || 0;
    document.getElementById("stat-sorteios").textContent =
      s.total_sorteios || 0;
    const total = s.total_participantes || 1;
    const presentes = s.total_presentes || 0;
    const pct = Math.round((presentes / total) * 100);
    document.getElementById("progress-presenca").style.width = pct + "%";
    document.getElementById("progress-text").textContent =
      presentes + " / " + total + " presentes (" + pct + "%)";
  } catch (e) {
    console.error("Erro ao atualizar dashboard:", e);
  }
}

async function carregarParticipantes() {
  try {
    const r = await fetch(API_URL + "/participantes");
    const lista = await r.json();
    const cont = document.getElementById("lista-participantes");
    if (!lista || lista.length === 0) {
      cont.innerHTML =
        '<p class="empty-state">Nenhum participante registrado</p>';
      return;
    }
    let html = "";
    lista.forEach((p) => {
      html +=
        '<div style="padding:12px;border:1px solid #ddd;margin:8px 0;border-radius:6px;"><strong>Nº ' +
        p.numero +
        " - " +
        p.nome +
        "</strong><br/>Tipo: " +
        p.tipo +
        " | Status: " +
        (p.status || "AUSENTE") +
        "<br/>";
      html +=
        '<button onclick="editarParticipante(' +
        p.id +
        ')" style="padding:6px;background:#2158CE;color:white;border:none;cursor:pointer;margin-right:5px;border-radius:4px;">Editar</button>';
      html +=
        '<button onclick="deletarParticipante(' +
        p.id +
        ",'" +
        p.nome.replace(/'/g, "\\'") +
        '\')" style="padding:6px;background:#C01527;color:white;border:none;cursor:pointer;border-radius:4px;">Deletar</button></div>';
    });
    cont.innerHTML = html;
  } catch (e) {
    console.error("Erro ao carregar participantes:", e);
  }
}

async function carregarListaPresenca() {
  try {
    console.log("🔄 Carregando lista de presença...");
    const r = await fetch(API_URL + "/presenca/lista");
    const lista = await r.json();
    listaParticipantesCompleta = lista;

    const buscaEl = document.getElementById("busca-recepcao");
    if (buscaEl) buscaEl.value = "";

    if (!lista || lista.length === 0) {
      document.getElementById("lista-presenca").innerHTML =
        '<p class="empty-state">Nenhum participante registrado</p>';
      return;
    }

    console.log("✓ Carregados " + lista.length + " participantes");
    renderizarListaPresenca(lista);
  } catch (e) {
    console.error("Erro ao carregar lista de presença:", e);
  }
}

function filtrarListaPresenca() {
  const termo = document.getElementById("busca-recepcao").value.trim();
  if (!termo) {
    renderizarListaPresenca(listaParticipantesCompleta);
    return;
  }
  const filtrados = listaParticipantesCompleta.filter((p) => {
    const id = p.id.toString();
    const numero = p.numero.toString();
    const nome = p.nome.toLowerCase();
    const termoBusca = termo.toLowerCase();
    return (
      id.includes(termoBusca) ||
      numero.includes(termoBusca) ||
      nome.includes(termoBusca)
    );
  });
  if (filtrados.length === 0) {
    document.getElementById("lista-presenca").innerHTML =
      '<p style="text-align:center;color:#999;">Nenhum encontrado</p>';
    return;
  }
  renderizarListaPresenca(filtrados);
}

function renderizarListaPresenca(lista) {
  const cont = document.getElementById("lista-presenca");
  let html = "";
  
  lista.forEach((p) => {
    const statusBD = p.status_presenca || "AUSENTE";
    const pagoBD = p.status_pago || "NAO_PAGO";

    const bg = statusBD === "PRESENTE" ? "#f0f9f9" : "#fff9f9";
    const color = statusBD === "PRESENTE" ? "#32B8C6" : "#A84B2F";
    const btnBg = statusBD === "PRESENTE" ? "#C01527" : "#32B8C6";
    const btnText = statusBD === "PRESENTE" ? "✗ Marcar Ausente" : "✓ Marcar Presente";
    const btnAction = statusBD === "PRESENTE" ? "marcarAusente" : "marcarPresenca";

    const pagoLabel = pagoBD === "PAGO" ? "✓ Pago" : "✗ Não pago";
    const pagoClass = pagoBD === "PAGO" ? "badge-pago" : "badge-nao-pago";
    const statusText = statusBD === "PRESENTE" ? "✓ PRESENTE" : "✗ AUSENTE";

    html +=
      '<div id="participante-' + p.id +
      '" style="padding:12px;border:1px solid #ddd;margin:8px 0;border-radius:6px;background:' + bg +
      ';"><div style="display:flex;justify-content:space-between;align-items:center;gap:15px;"><div style="flex:1;"><strong>Nº ' + p.numero + ' - ' + p.nome +
      '</strong><br/><span style="color:#666;font-size:13px;">ID: ' + p.id + ' | Tipo: ' + p.tipo +
      '</span></div><div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;"><span style="background:' + color +
      ';color:white;padding:6px 12px;border-radius:12px;font-weight:bold;font-size:12px;">' + statusText +
      '</span><span class="badge-status ' + pagoClass + '">' + pagoLabel +
      '</span></div></div><button id="btn-' + p.id + '" onclick="' + btnAction + '(' + p.id + ',\'' + p.nome.replace(/'/g, "\\'") +
      '\')" style="width:100%;padding:10px;margin-top:8px;background:' + btnBg +
      ';color:white;border:none;cursor:pointer;border-radius:4px;font-weight:bold;transition:all 0.3s;">' + btnText + '</button>' + '<select id="select-pago-' + p.id + '" style="padding:8px;border:1px solid #ddd;border-radius:4px;font-weight:bold;" onchange="atualizarStatusPago(' + p.id + ');">' + '<option value="">Pagto</option>' + '<option value="PAGO" ' + (pagoBD === "PAGO" ? "selected" : "") + '>✓ Pago</option>' + '<option value="NAO_PAGO" ' + (pagoBD === "NAO_PAGO" ? "selected" : "") + '>✗ Não</option>' + '</select></div>';
  });
  
  cont.innerHTML = html;
}
  const tipo = document.getElementById("tipo-input").value;
  const id = document.getElementById("participante-id").value;
  if (!numero || !nome) {
    alert("⚠️ Preencha todos os campos obrigatórios");
    return;
  }
  const url = id
    ? API_URL + "/participantes/" + id
    : API_URL + "/participantes";
  const metodo = id ? "PUT" : "POST";
  fetch(url, {
    method: metodo,
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ numero: parseInt(numero), nome: nome, tipo: tipo }),
  })
    .then((r) =>
      r.ok
        ? r.json()
        : r.json().then((e) => {
            throw new Error(e.error);
          })
    )
    .then(() => {
      alert("✓ " + (id ? "Atualizado" : "Criado") + " com sucesso!");
      limparFormulario();
      carregarParticipantes();
      atualizarDashboard();
    })
    .catch((e) => alert("❌ Erro: " + e.message));
}

function editarParticipante(id) {
  fetch(API_URL + "/participantes/" + id)
    .then((r) => r.json())
    .then((p) => {
      document.getElementById("participante-id").value = id;
      document.getElementById("numero-input").value = p.numero;
      document.getElementById("nome-input").value = p.nome;
      document.getElementById("tipo-input").value = p.tipo;
    })
    .catch((e) => console.error("Erro ao editar:", e));
}

function deletarParticipante(id, nome) {
  if (!confirm('Tem certeza que deseja deletar "' + nome + '"?')) return;
  fetch(API_URL + "/participantes/" + id, { method: "DELETE" })
    .then((r) => {
      if (r.ok) {
        alert("✓ Participante deletado!");
        carregarParticipantes();
        atualizarDashboard();
      } else {
        throw new Error("Erro ao deletar");
      }
    })
    .catch((e) => alert("❌ Erro: " + e.message));
}

function limparFormulario() {
  document.getElementById("participante-id").value = "";
  document.getElementById("numero-input").value = "";
  document.getElementById("nome-input").value = "";
  document.getElementById("tipo-input").value = "Aluno";
}

async function marcarPresenca(id, nome) {
  try {
    console.log("🔄 Marcando presente para ID: " + id + " - " + nome);
    const btn = document.getElementById("btn-" + id);
    if (btn) {
      btn.disabled = true;
      btn.style.opacity = "0.6";
    }

    const r = await fetch(API_URL + "/presenca", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ participante_id: id }),
    });

    if (r.ok) {
      alert("✓ " + nome + " marcado como PRESENTE!");
      setTimeout(() => {
        atualizarDashboard();
        setTimeout(() => {
          carregarListaPresenca();
        }, 2000);
      }, 500);
    } else {
      const err = await r.json();
      alert("❌ Erro: " + (err.error || "Falha ao marcar presença"));
      if (btn) {
        btn.disabled = false;
        btn.style.opacity = "1";
      }
    }
  } catch (e) {
    alert("❌ Erro na comunicação com o servidor");
    const btn = document.getElementById("btn-" + id);
    if (btn) {
      btn.disabled = false;
      btn.style.opacity = "1";
    }
  }
}

async function marcarAusente(id, nome) {
  try {
    console.log("🔄 Marcando ausente para ID: " + id + " - " + nome);
    const btn = document.getElementById("btn-" + id);
    if (btn) {
      btn.disabled = true;
      btn.style.opacity = "0.6";
    }

    const r = await fetch(API_URL + "/presenca/ausente", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ participante_id: id }),
    });

    if (r.ok) {
      alert("✓ " + nome + " marcado como AUSENTE!");
      setTimeout(() => {
        atualizarDashboard();
        setTimeout(() => {
          carregarListaPresenca();
        }, 2000);
      }, 500);
    } else {
      const err = await r.json();
      alert("❌ Erro: " + (err.error || "Falha ao marcar ausente"));
      if (btn) {
        btn.disabled = false;
        btn.style.opacity = "1";
      }
    }
  } catch (e) {
    alert("❌ Erro na comunicação com o servidor");
    const btn = document.getElementById("btn-" + id);
    if (btn) {
      btn.disabled = false;
      btn.style.opacity = "1";
    }
  }
}

// ===== PREMIAÇÃO =====

let categoriasDisponiveis = [];

function inicializarPremiacoes() {
  console.log("✓ Inicializando premiações");
  carregarCategoriasParaPremio();
}

function carregarCategoriasParaPremio() {
  fetch(`${API_URL}/categorias`)
    .then((r) => r.json())
    .then((data) => {
      categoriasDisponiveis = data;
      const select = document.getElementById("categoria-filtro");
      if (select) {
        select.innerHTML =
          '<option value="">-- Escolha uma categoria --</option>';
        data.forEach((cat) => {
          select.innerHTML += `<option value="${cat.nome}">${cat.nome}</option>`;
        });
      }
    })
    .catch((e) => console.error("Erro ao carregar categorias:", e));
}

function carregarPremiosPorCategoria() {
  const categoria = document.getElementById("categoria-filtro").value;

  if (!categoria) {
    document.getElementById("lista-premios-container").innerHTML =
      '<p class="empty-state">Selecione uma categoria para ver os alunos</p>';
    return;
  }

  fetch(`${API_URL}/premios/categoria/${encodeURIComponent(categoria)}`)
    .then((r) => r.json())
    .then((data) => {
      if (!data || data.length === 0) {
        document.getElementById("lista-premios-container").innerHTML =
          '<p class="empty-state">Nenhum aluno nesta categoria</p>';
        return;
      }
      renderizarListaPremios(data);
    })
    .catch((e) => console.error("Erro ao carregar prêmios:", e));
}

function renderizarListaPremios(lista) {
  let html = '<table class="premiacoes-table"><thead><tr>';
  html +=
    "<th>Categoria</th><th>Nome</th><th>Status Presente</th><th>Status Entrega</th><th>Ação</th></tr></thead><tbody>";

  lista.forEach((premio) => {
    html += `<tr id="premio-${premio.id}">
    <td><strong>${premio.categoria_nome}</strong></td>
    <td>${premio.nome}</td>
      <td>
        <select class="form-control" style="width:120px;" onchange="atualizarPremio(${
          premio.id
        }, 'presente', this.value)">
          <option value="SIM" ${
            premio.status_presente === "SIM" ? "selected" : ""
          }>SIM</option>
          <option value="NAO" ${
            premio.status_presente === "NAO" ? "selected" : ""
          }>NÃO</option>
        </select>
      </td>
      <td>
        <select class="form-control" style="width:120px;" onchange="atualizarPremio(${
          premio.id
        }, 'entrega', this.value)">
          <option value="SIM" ${
            premio.status_entrega === "SIM" ? "selected" : ""
          }>SIM</option>
          <option value="NAO" ${
            premio.status_entrega === "NAO" ? "selected" : ""
          }>NÃO</option>
        </select>
      </td>
      <td><small style="color:#999;">ID: ${premio.id}</small></td>
    </tr>`;
  });

  html += "</tbody></table>";
  document.getElementById("lista-premios-container").innerHTML = html;
}

function atualizarPremio(premioId, tipo, novoValor) {
  const statusPresente =
    tipo === "presente"
      ? novoValor
      : document.querySelector(`#premio-${premioId} td:nth-child(2) select`)
          .value;
  const statusEntrega =
    tipo === "entrega"
      ? novoValor
      : document.querySelector(`#premio-${premioId} td:nth-child(3) select`)
          .value;

  fetch(`${API_URL}/premios/${premioId}`, {
    method: "PUT",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      status_presente: statusPresente,
      status_entrega: statusEntrega,
    }),
  })
    .then((r) => r.json())
    .then((data) => {
      if (data.sucesso) {
        console.log(`✓ Prêmio ${premioId} atualizado`);
      } else {
        console.error("Erro ao atualizar:", data.erro);
      }
    })
    .catch((e) => console.error("Erro na requisição:", e));

  // ===== ABAS GERENCIAR =====
  function showTab(tabId) {
    // Esconder todas as abas
    document.querySelectorAll(".tab-content").forEach((tab) => {
      tab.style.display = "none";
    });
    document.querySelectorAll(".tab-btn").forEach((btn) => {
      btn.classList.remove("active");
      btn.style.borderBottom = "3px solid transparent";
      btn.style.color = "#999";
    });

    // Mostrar aba selecionada
    document.getElementById(tabId).style.display = "block";
    event.target.classList.add("active");
    event.target.style.borderBottom = "3px solid #32b8c6";
    event.target.style.color = "#2b5a5f";
  }
}


async function atualizarStatusPago(participanteId) {
  const select = document.getElementById("select-pago-" + participanteId);
  const statusPago = select.value;
  
  if (!statusPago) {
    return;
  }
  
  try {
    const response = await fetch(API_URL + "/presenca/update-pago", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        participante_id: participanteId,
        status_pago: statusPago
      })
    });
    
    const data = await response.json();
    
    if (response.ok) {
      console.log("✓ Status pago atualizado:", statusPago);
      // Recarregar dados
      carregarParticipantes();
    } else {
      alert("❌ Erro: " + data.error);
      carregarParticipantes();
    }
  } catch (error) {
    console.error("Erro ao atualizar status pago:", error);
    alert("❌ Erro ao atualizar status de pagamento");
  }
}
