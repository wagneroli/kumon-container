def categorias():
    try:
        c = get_conn()
        if not c:
            return jsonify([]), 200
        cur = c.cursor(dictionary=True)
        cur.execute("SELECT * FROM categorias")
        r = cur.fetchall()
        cur.close()
        c.close()
        return jsonify(r), 200
