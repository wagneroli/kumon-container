#V10
from flask import Flask, request, jsonify
from flask_cors import CORS
import mysql.connector
from mysql.connector import pooling, Error

app = Flask(__name__)
CORS(app)

try:
    pool = pooling.MySQLConnectionPool(
        pool_name="p", pool_size=5,
        host='mysql', 
        user='kumon_user',
        password='kumon_pass_2025', 
        database='kumon_db',
        autocommit=True,
        use_pure=True,
        connection_timeout=5
    )
    print("✓ Pool MySQL conectado")
except Error as e:
    print(f"✗ Erro ao criar pool: {e}")
    pool = None

def get_conn():
    try:
        if pool:
            return pool.get_connection()
    except Error as e:
        print(f"Erro conexão: {e}")
    return None

@app.route('/api/health')
def health():
    c = get_conn()
    if c:
        c.close()
        return jsonify({"status": "ok"}), 200
    return jsonify({"status": "error"}), 500

@app.route('/api/stats')
def stats():
    try:
        c = get_conn()
        if not c:
            return jsonify({"error": "DB not connected"}), 500
        cur = c.cursor(dictionary=True)
        cur.execute("SELECT COUNT(*) t FROM participantes")
        p = cur.fetchone()['t'] or 0
        cur.execute("SELECT COUNT(*) t FROM presenca WHERE status='PRESENTE'")
        pr = cur.fetchone()['t'] or 0
        cur.execute("SELECT COUNT(*) t FROM premiacoes")
        prem = cur.fetchone()['t'] or 0
        cur.close()
        c.close()
        return jsonify({"total_participantes": int(p), "total_presentes": int(pr), "total_premios": int(prem)})
    except Exception as e:
        print(f"Erro stats: {e}")
        return jsonify({"error": str(e)}), 500

